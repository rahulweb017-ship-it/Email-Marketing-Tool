{
  "name": "@mailforge/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --import tsx/esm ../../node_modules/knex/bin/cli.js migrate:latest --knexfile src/db/knexfile.ts",
    "migrate:make": "node --import tsx/esm ../../node_modules/knex/bin/cli.js migrate:make --knexfile src/db/knexfile.ts",
    "migrate:rollback": "node --import tsx/esm ../../node_modules/knex/bin/cli.js migrate:rollback --knexfile src/db/knexfile.ts",
    "seed": "node --import tsx/esm ../../node_modules/knex/bin/cli.js seed:run --knexfile src/db/knexfile.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@self-hosted-email/shared": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
