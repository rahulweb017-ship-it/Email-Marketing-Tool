# Database
DATABASE_URL=postgresql://mailforge:mailforge_dev@localhost:5433/mailforge

# Redis
REDIS_URL=redis://localhost:6380

# API Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production-use-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HMAC secret for tracking tokens (unsubscribe links, pixel tokens)
HMAC_SECRET=change-me-tracking-secret-64-chars

# App
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# SMTP (optional - for self-hosted sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SendGrid (optional)
SENDGRID_API_KEY=

# AWS SES (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
