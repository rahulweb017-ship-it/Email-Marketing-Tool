# Database
DATABASE_URL=postgresql://mailforge:mailforge_dev@localhost:5433/mailforge

# Redis
REDIS_URL=redis://localhost:6380

# API Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production-use-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HMAC secret for tracking tokens (unsubscribe links, pixel tokens)
HMAC_SECRET=change-me-tracking-secret-64-chars

# App
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Uploaded email images/media (served at APP_URL/media/..., so APP_URL must be publicly reachable)
MEDIA_DIR=
MEDIA_MAX_MB=10

# SMTP (optional - for self-hosted sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SendGrid (optional)
SENDGRID_API_KEY=

# AWS SES (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Social media publishing (OAuth). Register this redirect URI with every platform:
#   ${APP_URL}/api/v1/social/accounts/callback  (or set SOCIAL_OAUTH_CALLBACK_URL to override)
SOCIAL_OAUTH_CALLBACK_URL=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Facebook app (also used for Instagram Business accounts)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile w_member_social
# YouTube: Google Cloud OAuth client (enable "YouTube Data API v3")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Threads: Meta app with the Threads API use case (Threads app ID/secret, not the Facebook ones)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Pinterest: API v5 app (pins are created on the account's first board)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# WhatsApp — Meta Cloud API webhooks (callback URL: <public host>/webhooks/whatsapp)
# App secret defaults to FACEBOOK_APP_SECRET when empty
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# AI for WhatsApp compose / reply suggestions / auto-replies (Claude API)
ANTHROPIC_API_KEY=
WHATSAPP_AI_MODEL=claude-opus-5-5

# AI image generation (OpenAI image API)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
